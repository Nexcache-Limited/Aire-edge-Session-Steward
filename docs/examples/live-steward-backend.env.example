NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://steward_user:replace-password@postgres.example.net:5432/session_steward
DATABASE_SSL_REJECT_UNAUTHORIZED=true
MIGRATIONS_RUN=false

SESSION_STEWARD_API_TOKEN=use-the-same-random-api-token-as-the-live-steward-web-project

# Keep disabled for the migration and first-boot checks.
NATS_ENABLED=false
NATS_URL=nats://replace-user:replace-password@nats.example.net:4222
NATS_DEPLOYMENT_SUBJECT=aire.deployment.events
NATS_TELEMETRY_SUBJECT=aire.telemetry.events
NATS_QOE_SUBJECT=aire.*.qoe.>
NATS_EVIDENCE_SUBJECT=aire.*.evidence.>
NATS_TRAINING_SUBJECT=aire.*.training.session.*.events

# Optional. The code already defaults to this service name.
OTEL_SERVICE_NAME=aire-edge-session-steward-service
